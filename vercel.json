{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://api.geo-epesege.com.ar/api/$1"
    },
    {
      "src": "/permisosdeobra/?",
      "dest": "/permisosdeobra.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
